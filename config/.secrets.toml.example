# Copy to config/.secrets.toml. Create the bot with @BotFather, send it any message, then read your chat id from
# https://api.telegram.org/bot<token>/getUpdates (result[0].message.chat.id).
[telegram]
token = ""
chat_id = ""

# Official Idealista API, from the approval email of developers.idealista.com. Empty keeps the Firefox cookie scraper.
[idealista]
api_key = ""
api_secret = ""

# Mailbox that receives Idealista alerts. For Gmail, enable 2-step verification and create an app password at
# https://myaccount.google.com/apppasswords; the normal password does not work over IMAP. Other providers: set
# email.host in settings.toml.
[email]
user = ""
password = ""
