# Copy to .env for Docker. Create the bot with @BotFather, send it any message, then read your chat id from
# https://api.telegram.org/bot<token>/getUpdates (result[0].message.chat.id). Several chats: comma separated ids.
HOUSE_FINDER_TELEGRAM__TOKEN=
HOUSE_FINDER_TELEGRAM__CHAT_ID=
# Official Idealista API (empty keeps the Firefox cookie scraper).
HOUSE_FINDER_IDEALISTA__API_KEY=
HOUSE_FINDER_IDEALISTA__API_SECRET=
# Mailbox with Idealista alerts; for Gmail use an app password (https://myaccount.google.com/apppasswords).
HOUSE_FINDER_EMAIL__USER=
HOUSE_FINDER_EMAIL__PASSWORD=
